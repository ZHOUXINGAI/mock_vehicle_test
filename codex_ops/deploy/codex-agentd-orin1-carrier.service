[Unit]
Description=Codex coordination worker (Orin1 Carrier)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jetson
Group=jetson
Environment=HOME=/home/jetson
Environment=PATH=/home/jetson/.nvm/versions/node/v22.22.3/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
Environment=http_proxy=http://127.0.0.1:7897
Environment=https_proxy=http://127.0.0.1:7897
Environment=all_proxy=socks5://127.0.0.1:7897
Environment=HTTP_PROXY=http://127.0.0.1:7897
Environment=HTTPS_PROXY=http://127.0.0.1:7897
Environment=ALL_PROXY=socks5://127.0.0.1:7897
Environment=NO_PROXY=localhost,127.0.0.1,::1
WorkingDirectory=/home/jetson/mock_vehicle_test
ExecStart=/home/jetson/mock_vehicle_test/codex_ops/local/venv/bin/python -m codex_ops.realtime.agentd --config /etc/codex-agentd/orin1-carrier.json
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateDevices=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true
UMask=0077

[Install]
WantedBy=multi-user.target
