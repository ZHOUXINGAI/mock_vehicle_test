Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.45
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 120; 120; 120
      Enabled: true
      Name: Ground Grid
      Plane: XY
      Reference Frame: <Fixed Frame>
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 0; 190; 255
      Enabled: true
      Head Diameter: 0.12
      Head Length: 0.18
      Length: 0.15
      Line Style: Lines
      Line Width: 0.06
      Name: Planned Trajectory
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.05
      Shaft Length: 0.10
      Topic:
        Depth: 5
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /orin2/offboard/planned_path
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 255; 210; 0
      Enabled: true
      Head Diameter: 0.12
      Head Length: 0.18
      Length: 0.15
      Line Style: Lines
      Line Width: 0.08
      Name: Actual Trajectory
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.05
      Shaft Length: 0.10
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /orin2/offboard/actual_path
    - Alpha: 1
      Axes Length: 0.45
      Axes Radius: 0.05
      Class: rviz_default_plugins/Pose
      Color: 40; 220; 90
      Enabled: true
      Head Length: 0.20
      Head Radius: 0.10
      Name: Vehicle Pose
      Shape: Arrow
      Shaft Length: 0.35
      Shaft Radius: 0.05
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /orin2/offboard/vehicle_pose
    - Alpha: 1
      Axes Length: 0.25
      Axes Radius: 0.03
      Class: rviz_default_plugins/Pose
      Color: 255; 70; 70
      Enabled: true
      Head Length: 0.15
      Head Radius: 0.07
      Name: Lookahead Target
      Shape: Arrow
      Shaft Length: 0.22
      Shaft Radius: 0.035
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /orin2/offboard/lookahead_target
  Enabled: true
  Global Options:
    Background Color: 28; 30; 34
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Angle: 0
      Class: rviz_default_plugins/TopDownOrtho
      Name: Top Down
      Scale: 18
      Target Frame: <Fixed Frame>
Window Geometry:
  Height: 900
  Width: 1400
